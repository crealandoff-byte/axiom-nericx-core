# Copier ce fichier en .env pour le developpement local.
# NE JAMAIS committer .env : il contient un secret.
#
# En production (Netlify) : Site configuration > Environment variables.

# Cle API du substrat d'inference. Obligatoire pour que le chat reponde.
OPENAI_API_KEY=

# Modele a utiliser. Optionnel : un defaut est applique si absent.
AXIOM_MODEL=

# URL de base du fournisseur. Optionnel : utile pour un proxy ou
# un fournisseur compatible expose a une autre adresse.
AXIOM_BASE_URL=
